# Safe test-only settings. These values are deterministic and non-secret.

# Application
APP_URL_SCHEMA=http
APP_DEBUG=true
APP_DOMAIN=localhost

# Interface language
I18N_DEFAULT_LANGUAGE=ru

# PostgreSQL
DB_USER=personal_workspace_test
DB_PASSWORD=personal_workspace_test_password
DB_DRIVER=postgresql+psycopg
DB_HOST=localhost
DB_PORT=55432
DB_NAME=personal_workspace_test
DB_POOL_PRE_PING=true
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_EXPIRE_ON_COMMIT=false
DB_LOG_QUERY_METRICS=false
DB_SLOW_QUERY_LOG_THRESHOLD_MS=250
DB_SLOW_QUERY_LOG_STATEMENT_MAX_LENGTH=1000

# Valkey
VALKEY_HOST=localhost
VALKEY_PORT=6379

# Private MinIO service
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_REGION=us-east-1
MINIO_SECRET_KEY=personal_workspace_test_secret_key
MINIO_ACCESS_KEY=personal_workspace_test_access_key
MINIO_SECURE=false

# Sentry
SENTRY_USE=false
SENTRY_DSN=

# TaskIQ
TASKIQ_RESULT_EXPIRE_SECONDS=3600
