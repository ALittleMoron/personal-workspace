# Container image tag
IMAGE_TAG=personal_workspace

# TLS edge
LE_EMAIL=your.letsencrypt@example.com
SSL_CERT=/certs/fullchain.pem
SSL_KEY=/certs/privkey.pem
VPN_INTERFACE=wg0
VPN_BIND_ADDRESS=10.77.0.1

# Application
APP_URL_SCHEMA=https
APP_DEBUG=false
APP_DOMAIN=workspace.example.com

# Interface language
I18N_DEFAULT_LANGUAGE=ru

# PostgreSQL
DB_USER=personal_workspace
DB_PASSWORD=
DB_DRIVER=postgresql+psycopg
DB_HOST=postgres
DB_PORT=5432
DB_NAME=personal_workspace
DB_POOL_PRE_PING=true
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_EXPIRE_ON_COMMIT=false
DB_LOG_QUERY_METRICS=false
DB_SLOW_QUERY_LOG_THRESHOLD_MS=250
DB_SLOW_QUERY_LOG_STATEMENT_MAX_LENGTH=1000

# Valkey
VALKEY_HOST=valkey
VALKEY_PORT=6379

# Private MinIO service
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_REGION=us-east-1
MINIO_SECRET_KEY=
MINIO_ACCESS_KEY=
MINIO_SECURE=false

# Sentry
SENTRY_USE=false
SENTRY_DSN=

# TaskIQ
TASKIQ_RESULT_EXPIRE_SECONDS=3600
