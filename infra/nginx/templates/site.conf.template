map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

limit_req_status 429;
limit_req_zone $binary_remote_addr zone=api_per_ip:20m rate=120r/m;

resolver 127.0.0.11 valid=10s ipv6=off;

upstream backend {
    zone backend_zone 64k;
    server ${ACTIVE_BACKEND_SLOT}:8080 resolve;
}

upstream frontend {
    zone frontend_zone 64k;
    server ${ACTIVE_FRONTEND_SLOT}:4000 resolve;
}

upstream minio_panel {
    zone minio_panel_zone 64k;
    server minio:9001 resolve;
}

upstream databasus {
    zone databasus_zone 64k;
    server databasus:4005 resolve;
}

server {
    listen 8080 default_server;
    server_name _;

    location = /nginx-healthz {
        access_log off;
        default_type text/plain;
        return 200 "";
    }

    location / {
        return 444;
    }
}

server {
    listen 8080;
    server_name ${APP_DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 8443 ssl default_server;
    server_name _;

    ssl_certificate ${SSL_CERT};
    ssl_certificate_key ${SSL_KEY};
    ssl_protocols TLSv1.2 TLSv1.3;

    return 444;
}

server {
    listen 8443 ssl;
    http2 on;
    server_name ${APP_DOMAIN};

    ssl_certificate ${SSL_CERT};
    ssl_certificate_key ${SSL_KEY};
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;
    ssl_protocols TLSv1.2 TLSv1.3;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Request-ID $request_id;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 300;
    proxy_send_timeout 300;

    location ^~ /api/docs {
        limit_req zone=api_per_ip burst=120 nodelay;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; img-src 'self' data: https://cdn.jsdelivr.net; font-src 'self' data: https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; connect-src 'self'; upgrade-insecure-requests" always;
        proxy_pass http://backend;
    }

    location /api/ {
        limit_req zone=api_per_ip burst=120 nodelay;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'" always;
        proxy_pass http://backend/api/;
    }

    # The frontend origin generates a per-response nonce, substitutes it into HTML, and returns
    # the matching CSP plus no-store. Do not replace, merge, or cache those response headers here.
    location / {
        proxy_pass http://frontend;
    }
}

server {
    listen 18081;
    server_name _;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    location / {
        proxy_pass http://minio_panel;
    }
}

server {
    listen 18082;
    server_name _;

    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer" always;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    location / {
        proxy_pass http://databasus;
    }
}
